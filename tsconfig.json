{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "skipLibCheck": true
  },
  "include": [
    "app.js",
    "drivers/**/*.js",
    "lib/**/*.js",
    "test/**/*.js"
  ],
  "exclude": [
    "node_modules",
    ".homeybuild"
  ]
}
